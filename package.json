{
  "name": "intervista-ai-root",
  "version": "1.0.0",
  "private": true,
  "description": "Intervista AI - Complete AI-Powered Interview Preparation Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run dev\"",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "backend": "cd Backend && .\\venv\\Scripts\\uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
