# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervista_ai

# Secret key used to sign JWT tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# JWT algorithm + token lifetime (minutes)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (for CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application URL (used in email buttons and links)
APP_URL=http://localhost:5173

# Optional: Transactional Email API key (e.g. Resend)
# If provided, emails are sent via API; otherwise falls back to SMTP or dev console logging
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=

# Email Sender Details
EMAIL_FROM=Intervista AI <no-reply@intervista.ai>
EMAIL_FROM_NAME=Intervista AI

# SMTP settings for signup email verification OTPs and notification emails. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=Intervista AI <your-email@gmail.com>

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI in Google Cloud Console: http://localhost:5173/oauth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173/oauth/callback

# GitHub OAuth App Credentials (Get from https://github.com/settings/developers)
# Authorization callback URL in GitHub OAuth App: http://localhost:5173/oauth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5173/oauth/github/callback



