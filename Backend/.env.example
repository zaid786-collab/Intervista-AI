# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervista_ai

# Secret key used to sign JWT tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# JWT algorithm + token lifetime (minutes)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (for CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP settings for signup email verification OTPs. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=Intervista AI <your-email@gmail.com>
